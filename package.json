{
  "name": "sync-repository",
  "version": "1.1.0",
  "description": "A Github action to sync a Git repository",
  "main": "action.yml",
  "scripts": {
    "lint": "eslint --ext .ts,.yml --fix action.yml .github tests",
    "lint-no-fix": "npm run lint -- --no-fix",
    "test": "jest --ci",
    "version": "auto-changelog && git add CHANGELOG.md"
  },
  "git": {
    "pre-commit": [
      "lint-no-fix"
    ]
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvuckovic/sync-repository"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vercel/git-hooks": "^1.0.0",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.6.0",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-json-schema-validator": "^6.2.0",
    "eslint-plugin-jsonc": "^3.3.0",
    "jest": "^30.4.2",
    "js-yaml": "^5.2.1",
    "typescript": "^7.0.2"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ],
      "@babel/preset-typescript"
    ]
  },
  "jest": {
    "clearMocks": true,
    "restoreMocks": true
  },
  "eslintConfig": {
    "env": {
      "browser": false,
      "node": true,
      "commonjs": true,
      "es2021": true
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:jest/all",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:json-schema-validator/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "project": "./tsconfig.json"
    },
    "overrides": [
      {
        "files": [
          "*.yml",
          "*.yaml"
        ],
        "parser": "yaml-eslint-parser",
        "rules": {
          "jest/unbound-method": "off"
        }
      }
    ],
    "rules": {
      "indent": [
        "error",
        4
      ],
      "json-schema-validator/no-invalid": [
        "error",
        {
          "useSchemastoreCatalog": true
        }
      ]
    }
  },
  "auto-changelog": {
    "commitLimit": 99,
    "hideCredit": true,
    "package": true,
    "template": "keepachangelog"
  }
}
